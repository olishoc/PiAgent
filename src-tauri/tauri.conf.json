{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiAgent",
  "version": "0.1.30",
  "identifier": "com.piagent.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev:desktop-ui",
      "cwd": "..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": ".."
    },
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../client/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PiAgent",
        "width": 1440,
        "height": 920,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:1456 ws://127.0.0.1:1456 http://127.0.0.1:5173 ws://127.0.0.1:5173; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../server/dist": "server/dist",
      "../server/package.json": "server/package.json",
      "../client/dist": "client/dist",
      "r/node_modules": "node_modules",
      "binaries/node-x86_64-pc-windows-msvc.exe": "binaries/node-x86_64-pc-windows-msvc.exe"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNDFEQjYwRUQ4NEZCMEEKUldRSys0VHRZTnRCd0NEcTNMTHRwQ0lOSFBpelo0WGFwVXFiSE5BaE1tSGJZVHhyWXorRUxVWHIK",
      "endpoints": [
        "https://github.com/olishoc/PiAgent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
