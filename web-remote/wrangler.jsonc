{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rblxagent-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PUBLIC_HOST": "rblxagent.com",
    "PROTOCOL_VERSION": "2026-06-remote-v1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REMOTE_DESKTOP",
        "class_name": "RemoteDesktop"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RemoteDesktop"]
    }
  ]
}
